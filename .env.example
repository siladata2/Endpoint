# ==========================================================
#  SILA API  —  environment
#  Copy this file to  .env  and fill in your own values.
# ==========================================================

# Port the server listens on (Heroku/Render set this for you)
PORT=3000

# Public address of this server (used in responses and examples)
BASE_URL=https://api.silatech.site

# MongoDB connection string — the website + admin panel read live data from here
MONGODB_URI=mongodb://127.0.0.1:27017/sila_api

# OPTIONAL admin bootstrap account.
# You do NOT need these anymore: the first time you open /sila you create
# the admin account (username + PIN) and it is stored in MongoDB.
# If you set them, they also work as a login (and are copied into MongoDB).
ADMIN_USERNAME=
ADMIN_PIN=

# OPTIONAL. When empty, a secret is generated once and stored in MongoDB,
# so admin sessions survive server restarts.
ADMIN_TOKEN_SECRET=
