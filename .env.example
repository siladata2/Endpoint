PORT=3000
NODE_ENV=production

BASE_URL=https://api.silatech.site

# Put your REAL values in .env (or your host's config vars). Never commit them.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/

ADMIN_USERNAME=change_me
ADMIN_PIN=change_me_to_a_long_pin

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=change_me
